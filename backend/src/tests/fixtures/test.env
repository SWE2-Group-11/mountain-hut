# Environment of the backend under test: read by vitest.config.mts (backend tests) and by
# e2e/playwright.config.ts, which starts the backend for the end-to-end tests.
# Test fixtures only, not secrets. The app itself never reads this file.

SESSION_SECRET=test-session-secret

# Relative to backend/, the working directory of both test runners
SEED_ACCOUNTS_FILE=src/tests/fixtures/seed-accounts.json

# Fixed slots and bookings (src/tests/fixtures/seed.sql): the tests check exact tables and free seats
SEED_MODE=fixed