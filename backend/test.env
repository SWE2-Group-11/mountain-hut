# Test fixtures only, not secrets: loaded by vitest.config.mts and e2e/playwright.config.ts
# for the in-memory test database. The app itself never reads this file.
# The tests rely on the accounts in test-seed-accounts.json (emails, names, password "password").

SESSION_SECRET=test-session-secret

# Relative to backend/, the working directory of both test runners
SEED_ACCOUNTS_FILE=test-seed-accounts.json
