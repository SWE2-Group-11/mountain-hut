# Copy to .env and replace every value. .env is read by `docker compose`
# (and `docker run --env-file .env`) and by the backend npm scripts.

# Signs the session cookie. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-a-long-random-string

# Demo accounts, created only when the database is created (first start or RESET_DB=true):
# changing them later does not update an existing database.
# Numbering starts at 1 with no gaps; account <n> gets id <n>.
# The demo bookings in seed-core.sql belong to accounts 3 and 4, which must be hikers.
#
# Every account: ROLE (warden | employee | hiker), EMAIL, PASSWORD, NAME
# Hikers also:   MOBILE (required), NOTES and EMERGENCY_CONTACT (optional)
# Quote values that contain spaces.

SEED_ACCOUNT_1_ROLE=warden
SEED_ACCOUNT_1_EMAIL=warden@example.com
SEED_ACCOUNT_1_PASSWORD=change-me-warden
SEED_ACCOUNT_1_NAME=Wanda

SEED_ACCOUNT_2_ROLE=employee
SEED_ACCOUNT_2_EMAIL=employee@example.com
SEED_ACCOUNT_2_PASSWORD=change-me-employee
SEED_ACCOUNT_2_NAME=Emil

SEED_ACCOUNT_3_ROLE=hiker
SEED_ACCOUNT_3_EMAIL=hiker1@example.com
SEED_ACCOUNT_3_PASSWORD=change-me-hiker1
SEED_ACCOUNT_3_NAME="Hanna Example"
SEED_ACCOUNT_3_MOBILE="+39 300 000 0001"
SEED_ACCOUNT_3_NOTES="Mountain guide"
SEED_ACCOUNT_3_EMERGENCY_CONTACT="Ezio Example, +39 300 000 0002"

SEED_ACCOUNT_4_ROLE=hiker
SEED_ACCOUNT_4_EMAIL=hiker2@example.com
SEED_ACCOUNT_4_PASSWORD=change-me-hiker2
SEED_ACCOUNT_4_NAME="Hugo Example"
SEED_ACCOUNT_4_MOBILE="+39 300 000 0003"
