# Copy to .env and replace every value. .env is read by `docker compose`
# (and `docker run --env-file .env`) and by the backend npm scripts.

# Signs the session cookie. Use a long random string, e.g. `openssl rand -hex 32`.
SESSION_SECRET=replace-with-a-long-random-string

# Optional. Seed of the random demo data (any text): the same value recreates the same slots,
# bookings and hikes, relative to the day of the reset. If empty, a random seed is used and
# printed in the logs ("Random seed: ...").
SEED_RANDOM_SEED=