{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1,"showNotesDataMenu":false},"erDesign":{"model":{"uid":50,"erCode":"/* Entities */\nentity SLOT {\n    date (id),\n    start_time (id),\n    duration\n}\nentity SLOT_TABLE {\n    table_number (external),\n    seats\n}\nentity BOOKING {\n    id (id)\n}\nentity DIETARY_REQUIREMENT {\n    id (id),\n    allergy_flag,\n    description\n}\nentity HIKER {\n    mobile_number,\n    notes (optional),\n    full_name,\n    emergency_contact (optional)\n}\nentity STAFF {\n    role,\n    name\n}\nentity ACCOUNT {\n    id (id),\n    email,\n    password_hash,\n    password_salt,\n    must_change_password\n}\nentity TEMPORARY_HIKER {\n    full_name,\n    mobile_number (optional)\n}\n\n/* Relationships */\nrelationship HAS_TABLE (\n    SLOT: zero..many,\n    SLOT_TABLE: one..one external\n)\nrelationship HAS_REQUIREMENT (\n    DIETARY_REQUIREMENT: one..one,\n    BOOKING: zero..many\n)\nrelationship SEATED_AT (\n    SLOT_TABLE: zero..many,\n    BOOKING: one..many\n) {\n    assigned_seats\n}\nrelationship BOOKED_FOR_HIKER (\n    BOOKING: zero..one,\n    HIKER: zero..many\n)\nrelationship BOOKED_FOR_TEMP_HIKER (\n    BOOKING: zero..one,\n    TEMPORARY_HIKER: one..one external\n)\n\n/* Generalizations */\nACCOUNT <= {\n    HIKER,\n    STAFF\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"SLOT","_x":-358,"_y":-394,"_mag":false},{"__type":"Attribute","_id":2,"_name":"date","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"start_time","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":-42},{"__type":"Attribute","_id":4,"_name":"duration","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-144,"_y":44},{"__type":"Entity","_id"