{"_main":{"step":"erDesign","restructuringHappened":false,"draftSaved":true,"showMenu":false,"showModal":false,"containerWidth":500,"containerHeight":580,"uid":1},"erDesign":{"model":{"uid":87,"erCode":"/* Entities */\nentity SLOT {\n    date (id),\n    start_time (id),\n    duration,\n    menu (optional)\n}\nentity SLOT_TABLE {\n    table_number (external),\n    seats\n}\nentity BOOKING {\n    id (id)\n}\nentity DIETARY_REQUIREMENT {\n    id (id),\n    allergy_flag,\n    description\n}\nentity HIKER {\n    mobile_number,\n    notes (optional),\n    full_name,\n    emergency_contact (optional)\n}\nentity STAFF {\n    role,\n    name\n}\nentity ACCOUNT {\n    id (id),\n    email,\n    password_hash,\n    password_salt,\n    must_change_password\n}\nentity TEMPORARY_HIKER {\n    full_name,\n    mobile_number (optional)\n}\nentity PASSWORD_RESET_TOKEN {\n    created_at,\n    token_hash (id),\n    expires_at\n}\nentity HIKE {\n    destination,\n    route,\n    id (id),\n    completed_at (optional),\n    planned_departure_at,\n    expected_return_at\n}\nentity POPULAR_HIKE {\n    destination,\n    route,\n    id (id)\n}\nentity POP_PASSAGE_POINT {\n    id (id),\n    name\n}\nentity PASSAGE_POINT {\n    position (external),\n    name\n}\n\n/* Relationships */\nrelationship HAS_TABLE (\n    SLOT: zero..many,\n    SLOT_TABLE: one..one external\n)\nrelationship HAS_REQUIREMENT (\n    DIETARY_REQUIREMENT: one..one,\n    BOOKING: zero..many\n)\nrelationship SEATED_AT (\n    SLOT_TABLE: zero..many,\n    BOOKING: one..many\n) {\n    assigned_seats\n}\nrelationship BOOKED_FOR_HIKER (\n    BOOKING: zero..one,\n    HIKER: zero..many\n)\nrelationship BOOKED_FOR_TEMP_HIKER (\n    BOOKING: zero..one,\n    TEMPORARY_HIKER: one..one external\n)\nrelationship HAS_RESET_TOKEN (\n    PASSWORD_RESET_TOKEN: one..one,\n    ACCOUNT: zero..one\n)\nrelationship REGISTERS (\n    HIKER: zero..many,\n    HIKE: one..one\n)\nrelationship HAS_POP_PASSAGE_POINT (\n    POPULAR_HIKE: zero..many,\n    POP_PASSAGE_POINT: one..many\n) {\n    position\n}\nrelationship HAS_PASSAGE_POINT (\n    HIKE: zero..many,\n    PASSAGE_POINT: one..one external\n)\n\n/* Generalizations */\nACCOUNT <= {\n    HIKER,\n    STAFF\n} (total, exclusive)","sqlCode":"","itemsArray":[{"__type":"Entity","_id":1,"_name":"SLOT","_x":-358,"_y":-394,"_mag":false},{"__type":"Attribute","_id":2,"_name":"date","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-140,"_y":0},{"__type":"Attribute","_id":3,"_name":"start_time","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":-138,"_y":-42},{"__type":"Attribute","_id":4,"_name":"duration","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":1,"_x":145,"_y":-30},{"__type":"Entity","_id":5,"_name":"SLOT_TABLE","_x":-353,"_y":11,"_mag":false},{"__type":"Attribute","_id":6,"_name":"table_number","_identifier":false,"_externalIdentifier":true,"_cardinality":"1_1","_parentId":5,"_x":-163,"_y":0},{"__type":"Attribute","_id":7,"_name":"seats","_identifier":false,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":5,"_x":-164,"_y":46},{"__type":"Relationship","_id":8,"_name":"HAS_TABLE","_x":-353,"_y":-215},{"__type":"Participation","_id":9,"_entityId":1,"_tableId":null,"_relationshipId":8,"_cardinality":"0_N","_externalIdentifier":false,"_role":""},{"__type":"Participation","_id":10,"_entityId":5,"_tableId":null,"_relationshipId":8,"_cardinality":"1_1","_externalIdentifier":true,"_role":""},{"__type":"Entity","_id":11,"_name":"BOOKING","_x":-359,"_y":405,"_mag":false},{"__type":"Attribute","_id":12,"_name":"id","_identifier":true,"_externalIdentifier":false,"_cardinality":"1_1","_parentId":11,"_x":-144,"_y":53},{"__type":"Entity","_id":13,"_name":"DIETARY_REQUIREMENT","_x":-1196,"_y":401,"_mag":false},{"__type":"Relationship","_id":14,"_name":"HAS_REQUIREMENT","_x":-740,"_y":408},{"__type":"Participation","_id":15,"_entityId":13,"_tableId":null,"_relatio